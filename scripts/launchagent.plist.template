<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.github.daiki44.claude-approver</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/Applications/ClaudeApprover.app/Contents/MacOS/ClaudeApprover</string>
    </array>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/ClaudeApprover/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/ClaudeApprover/stderr.log</string>
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
